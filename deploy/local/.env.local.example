# ─────────────────────────────────────────────
# COMMANDCENTER — LOCAL development environment
# Template only. Copy this file to backend/.env
# (gitignored) before running `npm run dev`.
# ─────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Local dev database (docker compose -f deploy/local/docker-compose.local.yml up -d)
DATABASE_URL=postgresql://commandcenter:commandcenter_dev_password@localhost:5433/commandcenter_dev

JWT_SECRET=local-dev-jwt-secret-change-me-32-characters!!
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-32-characters
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Vite dev server port
APP_ORIGIN=http://localhost:5173

# First-boot admin (only created when the users table is empty)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-now