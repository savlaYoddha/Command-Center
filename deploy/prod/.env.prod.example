# ─────────────────────────────────────────────
# COMMANDCENTER — PROD secrets (template)
# Copy this file to deploy/prod/.env.prod
# on the server and fill in REAL, STRONG values.
# NEVER commit the real .env.prod.
#
# CC_TAG is set automatically by the deploy script
# (main-<gitsha>); do not hardcode it here.
# ─────────────────────────────────────────────

POSTGRES_PASSWORD=change-me-prod-postgres-password
JWT_SECRET=change-me-prod-jwt-secret-32-characters!!
JWT_REFRESH_SECRET=change-me-prod-refresh-secret-32-characters
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-prod-admin-password
APP_ORIGIN=https://commandcenter.savlayoddha.in
COOKIE_SECURE=true
COOKIE_SAMESITE=lax