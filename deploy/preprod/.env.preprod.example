# ─────────────────────────────────────────────
# COMMANDCENTER — PRE-PROD secrets (template)
# Copy this file to deploy/preprod/.env.preprod
# on the server and fill in real values.
# NEVER commit the real .env.preprod.
#
# CC_TAG is set automatically by the deploy script
# (main-<gitsha>); do not hardcode it here.
# ─────────────────────────────────────────────

POSTGRES_PASSWORD=change-me-preprod-postgres-password
JWT_SECRET=change-me-preprod-jwt-secret-32-characters!!
JWT_REFRESH_SECRET=change-me-preprod-refresh-secret-32-characters
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-preprod-admin-password
APP_ORIGIN=https://staging.commandcenter.savlayoddha.in
COOKIE_SECURE=true
COOKIE_SAMESITE=lax